# PRIVATE SERVER CONFIGURATION. Never commit actual secrets or include them in web builds.
PREPPULSE_ENV=production
PREPPULSE_HOSTNAME=your-dns-name.centralindia.cloudapp.azure.com
PREPPULSE_PRIVATE_ROOT=/data/private
PREPPULSE_MONGO_URI=mongodb://mongo:27017
PREPPULSE_MONGO_DB=preppulse
PREPPULSE_SESSION_SECRET=replace-with-a-long-random-secret
PREPPULSE_SECURE_COOKIES=1
PREPPULSE_SESSION_COOKIE=__Host-preppulse_session
PREPPULSE_DURABLE_JOBS=1
PREPPULSE_AI_ENABLED=1
PREPPULSE_AI_PROVIDER=auto
PREPPULSE_AI_PROVIDER_ORDER=sarvam,azure
PREPPULSE_ALLOW_LOCAL_AI=0
PREPPULSE_STRICT_AI=1
PREPPULSE_FHIR_ENABLED=1
PREPPULSE_RESUME_ANALYSIS=1
PREPPULSE_SYNTHETIC_ONLY=1
PREPPULSE_AI_TIMEOUT=120
Main_Sarvam_AI_Credits=
SARVAM_MODEL=sarvam-105b
PREPPULSE_SARVAM_BUDGET_INR=500
AZURE_OPENAI_ENDPOINT=https://your-account.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=preppulse-chat
AZURE_OPENAI_API_KEY=
PREPPULSE_AZURE_AI_BUDGET_USD=50
PREPPULSE_TRANSLATION_PROVIDER=azure
PREPPULSE_VOICE_PROVIDER=azure
PREPPULSE_AZURE_FALLBACK=sarvam
PREPPULSE_TRANSLATION_FALLBACK=none
PREPPULSE_VOICE_FALLBACK=none
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=centralindia
AZURE_TRANSLATOR_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_KEY=
AZURE_STORAGE_ACCOUNT=your-private-storage-account
PREPPULSE_EMBED_PROVIDER=python
PREPPULSE_EMBED_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
PREPPULSE_EMBED_CACHE=/data/models/embeddings
HF_HOME=/data/models/huggingface
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=2
PYTHONPATH=/app/src
