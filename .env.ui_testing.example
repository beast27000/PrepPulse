# Copy only the settings you need into your PRIVATE .env. Never commit real keys.
# scripts/run_ui_testing.ps1 overrides database, private storage and session settings.
SARVAM_AI_CREDITS_ACC_1=
SARVAM_AI_CREDITS_ACC_2=
SARVAM_AI_CREDITS_ACC_3=
Gemini_free_api_keys=
SARVAM_MODEL=sarvam-105b
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional starting balances from the dashboard. These are estimates, not live balances.
# Leave blank when unknown. Entries must use the same units as the INR estimator.
SARVAM_ACC_1_STARTING_CREDITS=
SARVAM_ACC_2_STARTING_CREDITS=
SARVAM_ACC_3_STARTING_CREDITS=
# Set identical pool names for keys sharing ONE Sarvam organisation/wallet.
SARVAM_ACC_1_POOL=organisation_one
SARVAM_ACC_2_POOL=organisation_two
SARVAM_ACC_3_POOL=organisation_three

# Persistent rehearsal ceilings. Estimates are not provider invoices or live balances.
PREPPULSE_SARVAM_BUDGET_INR=50
PREPPULSE_GEMINI_REQUEST_LIMIT=200
SARVAM_INPUT_INR_PER_MILLION=30
SARVAM_OUTPUT_INR_PER_MILLION=100

# Optional local fallback. Use exact identifiers from your LM Studio server.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_CHAT_MODEL=qwen/qwen3-4b-2507
